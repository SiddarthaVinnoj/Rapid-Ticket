 <% layout("layouts/boilerplate") %>
<div class="details">
<div class="card">
  <img src="<%= listings.img %>" class="card-img-top" alt="...">
</div>
<div class="det">
  <div class="Trailer">
    <h3><b><p class="title"><%= listings.title %></p></b></h3><a href="<%= listings.link %>" target="_blank"><button class="btn btn-primary"  type="submit"><i class="fa-solid fa-circle-play"></i> Watch Trailer</button></a></div>
    <p class="desc"><%= listings.description %></p>
    <p class="genre"><%= listings.genre %></p>
   <a href="/index/<%= listings._id %>/list"><button class="btn btn-primary btn2" type="submit">Book Now</button></a>
</div>
</div>